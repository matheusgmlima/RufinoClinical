# Copy to .env.local and fill in. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://wkmjvqshquzwlrtlmnqa.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_lVdaqgQOlossYcZhO7cw4A_fF4PqYXS

# Server-only. Bypasses RLS. Set it in Vercel env vars, never in client code.
SUPABASE_SECRET_KEY=

# Mercado Pago → Suas integrações → (aplicação Checkout Transparente, API de Orders) → Credenciais.
# Checkout stays disabled until the public key, the access token and SUPABASE_SECRET_KEY are set.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Server-only.
MP_ACCESS_TOKEN=
# Server-only. Webhooks → Configurar notificações: URL https://<domínio>/api/webhooks/mercadopago,
# event "Order (Mercado Pago)"; copy the generated secret signature here. Check it with "Simular notificação":
# notifications of test-credential orders are signed by an internal Mercado Pago app and are rejected.
MP_WEBHOOK_SECRET=
# "true" only while using test credentials (sandbox buyer e-mails; Pix auto-approved). Never in production.
MP_TEST_MODE=

# Resend → API Keys (Sending access). Order e-mails stay off until the key and EMAIL_FROM are set;
# sending needs the domain verified in Resend → Domains.
RESEND_API_KEY=
# Sender on the verified domain, e.g. Rufino Clinical <pedidos@seudominio.com.br>
EMAIL_FROM=
# Store inbox that receives customer replies.
EMAIL_REPLY_TO=

# Melhor Envio → Integrações → Permissões de acesso → Gerar novo token (only "shipping-calculate").
# Without it the checkout uses the regional flat rates from the admin panel.
MELHOR_ENVIO_TOKEN=
# "production" with a token from melhorenvio.com.br; empty uses sandbox.melhorenvio.com.br.
MELHOR_ENVIO_ENV=
